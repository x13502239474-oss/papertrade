# PaperTrade A-Share 行情代理环境变量示例（供 Cloudflare Worker / 本地 wrangler dev 使用）
# 复制为 worker/.dev.vars（已在 .gitignore 中忽略）后填入你的个人密钥。
# 严禁将真实密钥提交到 Git 仓库或写入前端静态代码！

# 上游行情源：public | tushare | itick
UPSTREAM=public

# 允许跨域访问的前端 Origin（逗号分隔）
ALLOWED_ORIGINS=https://x13502239474-oss.github.io,http://localhost:4173

# 边缘缓存时长（秒）
CACHE_TTL_SEC=5

# 可选：Tushare Pro Token（仅当 UPSTREAM=tushare 且已开通 rt_k 实时日线权限时填写）
# 生产环境请通过 `npx wrangler secret put TUSHARE_TOKEN` 注入
TUSHARE_TOKEN=

# 可选：iTick API Token（仅当 UPSTREAM=itick 时填写）
# 生产环境请通过 `npx wrangler secret put ITICK_TOKEN` 注入
ITICK_TOKEN=
